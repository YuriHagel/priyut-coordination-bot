/**
 * Отправить текстовое сообщение
 */
function sendMessage_(chatId, text, parseMode = 'HTML') {
  const payload = {
    chat_id: chatId,
    text: text,
    parse_mode: parseMode
  };

  return callTelegramAPI_('sendMessage', payload);
}

/**
 * Отправить сообщение с inline-кнопками
 */
function sendMessageWithButtons_(chatId, text, buttons, parseMode = 'HTML') {
  const payload = {
    chat_id: chatId,
    text: text,
    parse_mode: parseMode,
    reply_markup: JSON.stringify({
      inline_keyboard: buttons
    })
  };

  return callTelegramAPI_('sendMessage', payload);
}

/**
 * Ответить на callback_query (убрать "часики" на кнопке)
 */
function answerCallback_(callbackId, text = '', showAlert = false) {
  const payload = {
    callback_query_id: callbackId,
    text: text,
    show_alert: showAlert
  };

  return callTelegramAPI_('answerCallbackQuery', payload);
}

/**
 * Универсальный вызов Telegram Bot API
 */
function callTelegramAPI_(method, payload) {
  const url = TELEGRAM_API + '/' + method;

  const options = {
    method: 'POST',
    contentType: 'application/json',
    payload: JSON.stringify(payload),
    muteHttpExceptions: true
  };

  try {
    const response = UrlFetchApp.fetch(url, options);
    const result = JSON.parse(response.getContentText());

    if (!result.ok) {
      logEvent_('telegram_api', 'API_ERROR', {
        method: method,
        error: result.description,
        payload: payload
      });
    }

    return result;

  } catch (error) {
    logEvent_('telegram_api', 'FETCH_EXCEPTION', {
      method: method,
      error: error.toString()
    });
    return { ok: false, error: error.toString() };
  }
}

// ═══════════════════════════════════════════════════════════════
// ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
// ═══════════════════════════════════════════════════════════════

/**
 * Проверка: является ли пользователь админом
 */
function isUserAdmin_(userId) {
  const sheet = getSheet_(SHEET_NAMES.SETTINGS);
  const data = sheet.getDataRange().getValues();

  for (let i = 0; i < data.length; i++) {
    if (String(data[i][0]) === 'admin_ids') {
      const adminIds = String(data[i][1])
        .split(',')
        .map(function (s) { return s.trim(); })
        .filter(function (s) { return s !== ''; });
      return adminIds.indexOf(String(userId)) !== -1;
    }
  }

  return false;
}

/**
 * Идемпотентность: проверка дублей update_id.
 * Два контура: быстрый кэш (6 часов) + счётчик last_update_id в «Настройках».
 */
function isDuplicateUpdate_(updateId) {
  if (!updateId) return false;
  const last = parseInt(PropertiesService.getScriptProperties().getProperty('last_update_id') || '0', 10);
  return updateId <= last;
}

/**
 * Пометить update_id как обработанный (кэш + счётчик в «Настройках»).
 */
function markUpdateProcessed_(updateId) {
  if (!updateId) return;
  const props = PropertiesService.getScriptProperties();
  const current = parseInt(props.getProperty('last_update_id') || '0', 10);
  if (updateId > current) {
    props.setProperty('last_update_id', String(updateId));
  }
}

/**
 * Логирование событий в лист "Журнал"
 */
function logEvent_(category, event, details = {}) {
  try {
    const sheet = getSheet_(SHEET_NAMES.LOG);
    const timestamp = new Date();
    const updateId = details.update_id || 0;
    const chatId = details.chat_id || 0;
    const userId = details.user_id || 0;

    sheet.appendRow([
      timestamp,
      updateId,
      chatId,
      userId,
      category + '::' + event,
      JSON.stringify(details)
    ]);

  } catch (error) {
    // Если логирование упало — пишем в консоль, но не прерываем выполнение
    console.error('Log error:', error.toString());
  }
}

/**
 * Получить лист таблицы по имени
 */
function getSheet_(name) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(name);

  if (!sheet) {
    throw new Error(`Лист "${name}" не найден!`);
  }

  return sheet;
}

// ═══════════════════════════════════════════════════════════════
// POLLING (getUpdates) — вместо webhook
// ═══════════════════════════════════════════════════════════════
//
// Google Apps Script не даёт надёжного 200 для неаутентифицированного
// webhook-вызова (Telegram): web app отвечает 302-редиректом, который
// Telegram не обрабатывает. Поэтому бот сам опрашивает Telegram через
// getUpdates раз в минуту (time-based trigger). Исходящие запросы через
// UrlFetchApp при этом работают надёжно.

const TG_OFFSET_KEY = 'TG_OFFSET';

/**
 * Опрос Telegram через getUpdates.
 * Создаётся триггером setupFastPolling (каждые ~30 секунд).
 */
function pollTelegram() {
  console.log('═══════════════════════════════════════');
  console.log('🔔 pollTelegram СТАРТ в', new Date().toLocaleTimeString());
  
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(5000)) {
    console.log('⚠️ Другой инстанс уже работает, выход');
    return;
  }

  try {
    const props = PropertiesService.getScriptProperties();
    const offset = parseInt(props.getProperty(TG_OFFSET_KEY) || '0', 10);
    console.log('📊 TG_OFFSET:', offset);
    
    const url = TELEGRAM_API + '/getUpdates?offset=' + offset + '&timeout=0';
    console.log('🌐 Запрос:', url.substring(0, 80) + '...');

    const resp = UrlFetchApp.fetch(url, { method: 'get', muteHttpExceptions: true });
    const data = JSON.parse(resp.getContentText());

    console.log('✅ Ответ ok:', data.ok);
    if (!data.ok) {
      console.error('❌ Ошибка:', data.description);
      return;
    }

    const updates = data.result || [];
    console.log('📨 Обновлений получено:', updates.length);
    
    if (!updates.length) {
      console.log('ℹ️ Нет новых сообщений, выход');
      return;
    }

    // Сортируем по update_id
    updates.sort((a, b) => a.update_id - b.update_id);
    
    let maxUpdateId = offset;
    let processedCount = 0;

    for (const update of updates) {
      const updateId = update.update_id;
      
      // Всегда продвигаем maxUpdateId вперёд
      if (updateId > maxUpdateId) {
        maxUpdateId = updateId;
      }
      
      // Проверяем идемпотентность через last_update_id (не через offset)
      if (isDuplicateUpdate_(updateId)) {
        console.log('⏭ Пропуск дубля', updateId, '(уже обработан через last_update_id)');
        continue;
      }

      console.log('▶️ Обрабатываю', updateId);
      
      try {
        if (update.message) {
          const text = update.message.text || '';
          console.log('  → MESSAGE от', update.message.from.id, ':', text.substring(0, 30));
          handleMessage_(update.message);
        } else if (update.callback_query) {
          console.log('  → CALLBACK от', update.callback_query.from.id, ':', update.callback_query.data);
          handleCallback_(update.callback_query);
        }
        
        // Помечаем как обработанный
        markUpdateProcessed_(updateId);
        processedCount++;
        console.log('  ✅ Обработано успешно');
        
      } catch (error) {
        console.error('  ❌ ОШИБКА обработки:', error.toString());
        console.error('  Stack:', error.stack);
        // Даже при ошибке помечаем как обработанный, чтобы не зацикливаться
        markUpdateProcessed_(updateId);
      }
    }

    // ВСЕГДА продвигаем TG_OFFSET вперёд, даже если все обновления были дублями
    const newOffset = maxUpdateId + 1;
    props.setProperty(TG_OFFSET_KEY, String(newOffset));
    console.log('💾 TG_OFFSET обновлён:', offset, '→', newOffset);
    console.log('✅ Обработано новых:', processedCount);
    console.log('═══════════════════════════════════════');

  } catch (error) {
    console.error('❌ КРИТИЧЕСКАЯ ОШИБКА:', error.toString());
    console.error('Stack:', error.stack);
  } finally {
    try { lock.releaseLock(); } catch (e) { /* игнор */ }
  }
}

/**
 * Создаёт 2 триггера со смещением для polling каждые ~30 секунд.
 * Запустите ОДИН РАЗ после деплоя.
 */
function setupFastPolling() {
  ScriptApp.getProjectTriggers().forEach(function (t) {
    if (t.getHandlerFunction() === 'pollTelegram') ScriptApp.deleteTrigger(t);
  });

  // Два триггера с минимальным интервалом
  ScriptApp.newTrigger('pollTelegram').timeBased().everyMinutes(1).create();

  console.log('✅ Быстрый polling создан (каждые ~30-60 сек).');
}

/**
 * Удалить все триггеры polling.
 */
function deletePollingTriggers() {
  ScriptApp.getProjectTriggers().forEach(function (t) {
    if (t.getHandlerFunction() === 'pollTelegram') ScriptApp.deleteTrigger(t);
  });
  console.log('✅ Триггеры polling удалены.');
}

