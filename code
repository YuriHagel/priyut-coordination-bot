/**
 * Ядро бота «Приют» — polling (getUpdates), роутинг, отправка сообщений.
 * Версия: 1.0
 * Дата: 31.10.2026
 */

// ═══════════════════════════════════════════════════════════════
// КОНФИГУРАЦИЯ
// ═══════════════════════════════════════════════════════════════

const SCRIPT_PROPS = PropertiesService.getScriptProperties();
const BOT_TOKEN = SCRIPT_PROPS.getProperty('BOT_TOKEN');

if (!BOT_TOKEN) {
  throw new Error('BOT_TOKEN не задан в Script Properties!');
}

const TELEGRAM_API = 'https://api.telegram.org/bot' + BOT_TOKEN;

// Метка сборки для /version
const BUILD = '1.0 - final';

// ID листов таблицы (загружаем один раз при старте скрипта)
const SHEET_NAMES = {
  VOLUNTEERS: 'Волонтёры',
  TRIPS: 'Поездки',
  RESPONSES: 'Отклики',
  LOG: 'Журнал',
  SETTINGS: 'Настройки',
  QUEUE: 'Очередь'
};

// ═══════════════════════════════════════════════════════════════
// РОУТИНГ СООБЩЕНИЙ И КНОПОК
// ═══════════════════════════════════════════════════════════════

function handleMessage_(message) {
  const chatId = message.chat.id;
  const userId = message.from.id;
  const text = (message.text || '').trim();

  // ПРИМЕЧАНИЕ: намеренно НЕ логируем каждое сообщение (MESSAGE_RECEIVED) —
  // appendRow в hot path тормозил webhook-ответ за таймаут Telegram (~10с),
  // вызывая retry-петлю и потерю сообщений. Значимые события логируются ниже.

  // Wizard регистрации
  const regSession = getRegSession_(userId);
  if (regSession && text !== '' && text.charAt(0) !== '/') {
    processRegText_(userId, chatId, text, regSession);
    return;
  }

  // Wizard создания поездки
  const tripSession = getTripSession_(userId);
  if (tripSession && text !== '' && text.charAt(0) !== '/') {
    processTripText_(userId, chatId, text, tripSession);
    return;
  }

  // Причина отмены свободным текстом (волонтёр)
  if (getCnlSession_(userId) && text !== '' && text.charAt(0) !== '/') {
    processCancelReasonText_(userId, chatId, text);
    return;
  }

  // Новое время поездки (админ)
  if (getChgSession_(userId) && text !== '' && text.charAt(0) !== '/') {
    processChangeTimeText_(userId, chatId, text);
    return;
  }

  if (text.charAt(0) === '/') {
    const command = text.split(' ')[0].split('@')[0];
    handleCommand_(command, message);
  } else {
    sendMessage_(chatId, 'Я понимаю только команды и кнопки.\nНапишите /help для списка команд.');
  }
}

function handleCallback_(callback) {
  const userId = callback.from.id;
  const data = callback.data || '';

  // ПРИМЕЧАНИЕ: аналогично handleMessage_ — НЕ логируем каждый callback
  // (CALLBACK_RECEIVED) во избежание appendRow в hot path.

  answerCallback_(callback.id);
  const id = function () { return parseInt(data.split(':')[1], 10); };

  // Ответы на кнопки в ПОСТАХ КАНАЛА приходят с chat.id канала,
  // поэтому отвечаем всегда в личный чат пользователя (userId).
  if (data.indexOf('reg:') === 0) {
    handleRegCallback_(userId, userId, data, callback.message.message_id);
  } else if (data.indexOf('adm:') === 0) {
    handleAdminCallback_(userId, userId, data);
  } else if (data.indexOf('tw:') === 0) {
    handleTripWizardCallback_(userId, userId, data);
  } else if (data.indexOf('resp:') === 0 || data.indexOf('skip:') === 0) {
    handleTripResponse_(userId, userId, data);
  } else if (data.indexOf('tappr:') === 0 || data.indexOf('trej:') === 0) {
    handleTripModeration_(userId, userId, data);
  } else if (data.indexOf('tcnlr:') === 0) {
    handleTripCancelReason_(userId, userId, data.split(':'));
  } else if (data.indexOf('tcnl:') === 0) {
    handleTripCancelStart_(userId, userId, id());
  } else if (data.indexOf('tdone:') === 0) {
    handleTripDone_(userId, userId, id());
  } else if (data.indexOf('tclose:') === 0) {
    handleTripClose_(userId, userId, id());
  } else if (data.indexOf('trework:') === 0) {
    handleTripRework_(userId, userId, id());
  } else if (data.indexOf('trep:') === 0) {
    handleTripRepublish_(userId, userId, id());
  } else if (data.indexOf('tcancel:') === 0) {
    handleTripFullCancel_(userId, userId, id());
  } else if (data.indexOf('tchg:') === 0) {
    handleTripChangeTimeStart_(userId, userId, id());
  } else if (data.indexOf('tconf:') === 0) {
    handleTripTimeConfirm_(userId, userId, id());
  } else if (data.indexOf('tref:') === 0) {
    handleTripTimeRefuse_(userId, userId, id());
  } else if (
    data.indexOf('r24y:') === 0 ||
    data.indexOf('r24n:') === 0 ||
    data.indexOf('r2y:') === 0 ||
    data.indexOf('r2n:') === 0
  ) {
    handleReminderAnswer_(userId, userId, data);
  } else if (data === 'pedit:0') {
    startRegEdit_(userId, userId);
  } else if (data === 'pdel:0') {
    cmdDeleteProfile_(userId, userId);
  } else if (data === 'pdely:0') {
    handleDeleteProfileConfirm_(userId, userId);
  } else if (data === 'pdeln:0') {
    sendMessage_(userId, '↩ Удаление отменено.');
  } else if (data === 'avon:0') {
    handleAvailabilityToggle_(userId, userId, true);
  } else if (data === 'avoff:0') {
    handleAvailabilityToggle_(userId, userId, false);
  } else if (data.indexOf('tnop:') === 0) {
    sendMessage_(userId, data === 'tnop:0' ? '↩ Действие отменено.' : 'ℹ️ Поездка на проверке у администратора.');
  } else {
    sendMessage_(userId, 'Неизвестная кнопка: ' + data);
  }
}

function handleCommand_(command, message) {
  const chatId = message.chat.id;
  const userId = message.from.id;
  const arg = (message.text || '').trim().split(' ').slice(1).join(' ').trim();

  switch (command) {
    case '/start': cmdStart_(chatId, userId); break;
    case '/help': cmdHelp_(chatId); break;
    case '/register': startRegistration_(userId, chatId); break;
    case '/new_trip': cmdNewTrip_(chatId, userId); break;
    case '/trips': cmdTrips_(chatId, userId); break;
    case '/open_trips': cmdOpenTrips_(chatId, userId); break;
    case '/my_trips': cmdMyTrips_(chatId, userId); break;
    case '/change_time': cmdChangeTime_(chatId, userId, arg); break;
    case '/cancel_trip': cmdCancelTrip_(chatId, userId, arg); break;
    case '/profile': cmdProfile_(chatId, userId); break;
    case '/availability': cmdAvailability_(chatId, userId); break;
    case '/stats': cmdStats_(chatId, userId); break;
    case '/volunteers': cmdVolunteers_(chatId, userId); break;
    case '/export_trips': cmdExportTrips_(chatId, userId); break;
    case '/delete_profile': cmdDeleteProfile_(chatId, userId); break;
    case '/withdraw_consent': cmdWithdrawConsent_(chatId, userId); break;
    case '/version': sendMessage_(chatId, '🛠 Сборка: ' + BUILD); break;
    default:
      sendMessage_(chatId, '❓ Неизвестная команда: ' + command + '\n\nНапишите /help для списка команд.');
  }
}

function cmdStart_(chatId, userId) {
  const volunteer = findVolunteerByTgId_(userId);
  const rulesVer = getSetting_('rules_version') || '1.0';
  const rulesDate = getSetting_('rules_date') || '31.10.2026';

  let text = '👋 Здравствуйте! Я бот-координатор автоволонтёров приюта «Приютино».\n\n' +
    '⚠️ Важно: я НЕ собираю персональные данные. Не указывайте ФИО и телефон — только ник.\n' +
    '📄 Правила бота: версия ' + rulesVer + ' от ' + rulesDate + '.\n\n';

  if (isUserAdmin_(userId)) {
    text += '🔑 Вы администратор. Команды: /new_trip, /trips, /volunteers, /stats\n\n';
  }

  if (volunteer && volunteer.status === 'Одобрен') {
    text += '✅ Вы уже зарегистрированы как волонтёр!\nКоманды: /open_trips, /my_trips, /profile, /availability';
    sendMessage_(chatId, text);
    return;
  }
  if (volunteer && volunteer.status === 'На модерации') {
    text += '⏳ Ваша анкета на модерации (проверка до 24 часов).';
    sendMessage_(chatId, text);
    return;
  }

  text += 'Хотите стать автоволонтёром?';
  sendMessageWithButtons_(chatId, text, [[
    { text: '📝 Зарегистрироваться', callback_data: 'reg:start' },
    { text: '❓ Как это работает', callback_data: 'reg:how' }
  ]]);
}

/**
 * /help — справка по командам
 */
function cmdHelp_(chatId) {
  sendMessage_(chatId,
    '📖 Команды:\n\n' +
    '👤 Волонтёр:\n' +
    '/start — начало работы\n' +
    '/open_trips — открытые заявки\n' +
    '/my_trips — мои поездки\n' +
    '/profile — мой профиль\n' +
    '/availability — режим доступности\n' +
    '/stats — моя статистика\n' +
    '/delete_profile — удалить анкету\n\n' +
    '🔑 Админ:\n' +
    '/new_trip — создать поездку\n' +
    '/trips — активные поездки\n' +
    '/volunteers — список волонтёров\n' +
    '/change_time [ID] — перенос времени\n' +
    '/cancel_trip [ID] — отмена поездки\n' +
    '/stats — статистика\n' +
    '/export_trips — экспорт CSV\n\n' +
    '🛠 /version — сборка');
}

// ═══════════════════════════════════════════════════════════════
// TELEGRAM API — ОТПРАВКА СООБЩЕНИЙ
// ═══════════════════════════════════════════════════════════════

/**
 * Отправить текстовое сообщение
 */
function sendMessage_(chatId, text, parseMode = 'HTML') {
  const payload = {
    chat_id: chatId,
    text: text,
    parse_mode: parseMode
  };

  return callTelegramAPI_('sendMessage', payload);
}

/**
 * Отправить сообщение с inline-кнопками
 */
function sendMessageWithButtons_(chatId, text, buttons, parseMode = 'HTML') {
  const payload = {
    chat_id: chatId,
    text: text,
    parse_mode: parseMode,
    reply_markup: JSON.stringify({
      inline_keyboard: buttons
    })
  };

  return callTelegramAPI_('sendMessage', payload);
}

/**
 * Ответить на callback_query (убрать "часики" на кнопке)
 */
function answerCallback_(callbackId, text = '', showAlert = false) {
  const payload = {
    callback_query_id: callbackId,
    text: text,
    show_alert: showAlert
  };

  return callTelegramAPI_('answerCallbackQuery', payload);
}

/**
 * Универсальный вызов Telegram Bot API
 */
function callTelegramAPI_(method, payload) {
  const url = TELEGRAM_API + '/' + method;

  const options = {
    method: 'POST',
    contentType: 'application/json',
    payload: JSON.stringify(payload),
    muteHttpExceptions: true
  };

  try {
    const response = UrlFetchApp.fetch(url, options);
    const result = JSON.parse(response.getContentText());

    if (!result.ok) {
      logEvent_('telegram_api', 'API_ERROR', {
        method: method,
        error: result.description,
        payload: payload
      });
    }

    return result;

  } catch (error) {
    logEvent_('telegram_api', 'FETCH_EXCEPTION', {
      method: method,
      error: error.toString()
    });
    return { ok: false, error: error.toString() };
  }
}

// ═══════════════════════════════════════════════════════════════
// ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
// ═══════════════════════════════════════════════════════════════

/**
 * Проверка: является ли пользователь админом
 */
function isUserAdmin_(userId) {
  const sheet = getSheet_(SHEET_NAMES.SETTINGS);
  const data = sheet.getDataRange().getValues();

  for (let i = 0; i < data.length; i++) {
    if (String(data[i][0]) === 'admin_ids') {
      const adminIds = String(data[i][1])
        .split(',')
        .map(function (s) { return s.trim(); })
        .filter(function (s) { return s !== ''; });
      return adminIds.indexOf(String(userId)) !== -1;
    }
  }

  return false;
}

/**
 * Идемпотентность: проверка дублей update_id по единому счётчику last_update_id.
 */
function isDuplicateUpdate_(updateId) {
  if (!updateId) return false;
  const last = parseInt(PropertiesService.getScriptProperties().getProperty(LAST_UPDATE_KEY) || '0', 10);
  return updateId <= last;
}

/**
 * Пометить update_id как обработанный (продвинуть last_update_id).
 */
function markUpdateProcessed_(updateId) {
  if (!updateId) return;
  const props = PropertiesService.getScriptProperties();
  const current = parseInt(props.getProperty(LAST_UPDATE_KEY) || '0', 10);
  if (updateId > current) {
    props.setProperty(LAST_UPDATE_KEY, String(updateId));
  }
}

/**
 * Логирование событий в лист "Журнал"
 */
function logEvent_(category, event, details = {}) {
  try {
    const sheet = getSheet_(SHEET_NAMES.LOG);
    const timestamp = new Date();
    const updateId = details.update_id || 0;
    const chatId = details.chat_id || 0;
    const userId = details.user_id || 0;

    sheet.appendRow([
      timestamp,
      updateId,
      chatId,
      userId,
      category + '::' + event,
      JSON.stringify(details)
    ]);

  } catch (error) {
    // Если логирование упало — пишем в консоль, но не прерываем выполнение
    console.error('Log error:', error.toString());
  }
}

/**
 * Получить лист таблицы по имени
 */
function getSheet_(name) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(name);

  if (!sheet) {
    throw new Error(`Лист "${name}" не найден!`);
  }

  return sheet;
}

// ═══════════════════════════════════════════════════════════════
// POLLING (getUpdates) — вместо webhook
// ═══════════════════════════════════════════════════════════════
//
// Google Apps Script не даёт надёжного 200 для неаутентифицированного
// webhook-вызова (Telegram): web app отвечает 302-редиректом, который
// Telegram не обрабатывает. Поэтому бот сам опрашивает Telegram через
// getUpdates раз в минуту (time-based trigger). Исходящие запросы через
// UrlFetchApp при этом работают надёжно.

const LAST_UPDATE_KEY = 'last_update_id';
const FAILED_UPDATES_KEY = 'failed_updates';
const MAX_FAILED = 3; // сколько раз повторять битый апдейт перед пропуском

/**
 * Транзиентная ли ошибка (стоит повторить) или фатальная (бесполезно)?
 * Сетевые сбои Telegram уже глотаются внутри callTelegramAPI_, поэтому сюда
 * обычно долетают фатальные (лист/парсинг/данные). Транзиентными считаем
 * ресурсные/сетевые исключения GAS (quota, timeout, network).
 */
function isTransientError_(error) {
  const msg = String((error && error.message) || error || '');
  return /quota|rate.?limit|too many|timeout|timed ?out|network|fetch|ec2|socket|429|5\d\d/i.test(msg);
}

/**
 * Извлечь chat_id из update для оповещения о сбое.
 * Для callback отвечаем в личный чат (как handleCallback_).
 */
function getChatIdFromUpdate_(update) {
  if (!update) return null;
  if (update.message && update.message.chat) return update.message.chat.id;
  if (update.callback_query) return update.callback_query.from.id;
  return null;
}

/**
 * Оповестить пользователя о том, что команда не выполнена до конца.
 * Оборачиваем в try/catch: сама отправка может упасть из-за той же сети.
 */
function notifyProcessingError_(update) {
  const chatId = getChatIdFromUpdate_(update);
  if (!chatId) return;
  try {
    sendMessage_(chatId,
      '⚠️ По техническим причинам не удалось выполнить команду до конца.\n' +
      'Повторите, пожалуйста, последнее действие.');
  } catch (e) {
    console.error('Не удалось оповестить пользователя о сбое:', e.toString());
  }
}

/**
 * Опрос Telegram через getUpdates.
 * Идемпотентность: единый источник — last_update_id, offset = last_update_id + 1.
 * Блокирующий ретрай: при транзиентной ошибке апдейт НЕ подтверждается и НЕ
 * продвигает offset — следующий тик повторит его (и хвост очереди задержится,
 * что приемлемо при низком трафике). После MAX_FAILED — оповещаем и пропускаем.
 * Фатальная ошибка — сразу оповещаем и подтверждаем (re-работать бессмысленно).
 */
function pollTelegram() {
  console.log('═══════════════════════════════════════');
  console.log('🔔 pollTelegram СТАРТ в', new Date().toLocaleTimeString());

  const lock = LockService.getScriptLock();
  if (!lock.tryLock(5000)) {
    console.log('⚠️ Другой инстанс уже работает, выход');
    return;
  }

  try {
    const props = PropertiesService.getScriptProperties();
    const last = parseInt(props.getProperty(LAST_UPDATE_KEY) || '0', 10);
    const offset = last + 1;
    console.log('📊 last_update_id:', last, '→ offset:', offset);

    const url = TELEGRAM_API + '/getUpdates?offset=' + offset + '&timeout=0';

    const resp = UrlFetchApp.fetch(url, { method: 'get', muteHttpExceptions: true });
    const data = JSON.parse(resp.getContentText());

    console.log('✅ Ответ ok:', data.ok);
    if (!data.ok) {
      console.error('❌ Ошибка:', data.description);
      return;
    }

    const updates = data.result || [];
    console.log('📨 Обновлений получено:', updates.length);

    if (!updates.length) {
      console.log('ℹ️ Нет новых сообщений, выход');
      return;
    }

    // Сортируем по update_id (Telegram и так отдаёт по порядку — страховка).
    updates.sort((a, b) => a.update_id - b.update_id);

    // Счётчик неудачных попыток по апдейтам (id -> число попыток).
    const failed = readFailedUpdates_(props);

    let processedCount = 0;

    for (const update of updates) {
      const updateId = update.update_id;

      // Страховка от повторной отдачи того же номера (нормально быть не должно).
      if (updateId <= last) {
        console.log('⏭ Повторная отдача апдейта', updateId, '— пропуск');
        continue;
      }

      // Исчерпал лимит попыток — подтверждаем, оповещаем, двигаемся дальше.
      if (failed[updateId] >= MAX_FAILED) {
        console.error('⛔ Апдейт', updateId, 'провалился', failed[updateId], 'раз — пропускаю');
        delete failed[updateId];
        notifyProcessingError_(update);
        markUpdateProcessed_(updateId);
        continue;
      }

      console.log('▶️ Обрабатываю', updateId);

      try {
        if (update.message) {
          const text = update.message.text || '';
          console.log('  → MESSAGE от', update.message.from.id, ':', text.substring(0, 30));
          handleMessage_(update.message);
        } else if (update.callback_query) {
          console.log('  → CALLBACK от', update.callback_query.from.id, ':', update.callback_query.data);
          handleCallback_(update.callback_query);
        }

        // Успех: снимаем счётчик неудач, подтверждаем апдейт.
        delete failed[updateId];
        markUpdateProcessed_(updateId);
        processedCount++;
        console.log('  ✅ Обработано успешно');

      } catch (error) {
        console.error('  ❌ ОШИБКА обработки:', error.toString());

        if (isTransientError_(error)) {
          // Транзиентный сбой: НЕ подтверждаем и НЕ продвигаем offset —
          // следующий тик повторит апдейт. Прерываем цикл: хвост очереди
          // подождёт (head-of-line blocking), зато ничего не теряем и не дублируем.
          failed[updateId] = (failed[updateId] || 0) + 1;
          console.error('  🔁 Ретрай', failed[updateId] + '/' + MAX_FAILED, '— offset не продвигаю');
          writeFailedUpdates_(props, failed);
          return;
        }

        // Фатальная ошибка: оповещаем пользователя и подтверждаем, чтобы не блокировать.
        console.error('  Stack:', error.stack);
        notifyProcessingError_(update);
        markUpdateProcessed_(updateId);
      }
    }

    writeFailedUpdates_(props, failed);
    console.log('✅ Обработано новых:', processedCount);
    console.log('═══════════════════════════════════════');

  } catch (error) {
    console.error('❌ КРИТИЧЕСКАЯ ОШИБКА:', error.toString());
    console.error('Stack:', error.stack);
  } finally {
    try { lock.releaseLock(); } catch (e) { /* игнор */ }
  }
}

/** Прочитать счётчик неудачных апдейтов (JSON в ScriptProperties). */
function readFailedUpdates_(props) {
  try { return JSON.parse(props.getProperty(FAILED_UPDATES_KEY) || '{}'); }
  catch (e) { return {}; }
}

/** Сохранить счётчик неудачных апдейтов. */
function writeFailedUpdates_(props, failed) {
  props.setProperty(FAILED_UPDATES_KEY, JSON.stringify(failed));
}

/**
 * Создаёт триггер polling раз в минуту (минимальный интервал GAS).
 * Запустите ОДИН РАЗ после деплоя.
 */
function setupFastPolling() {
  ScriptApp.getProjectTriggers().forEach(function (t) {
    if (t.getHandlerFunction() === 'pollTelegram') ScriptApp.deleteTrigger(t);
  });

  ScriptApp.newTrigger('pollTelegram').timeBased().everyMinutes(1).create();

  console.log('✅ Polling-триггер создан (раз в минуту).');
}

/**
 * Удалить все триггеры polling.
 */
function deletePollingTriggers() {
  ScriptApp.getProjectTriggers().forEach(function (t) {
    if (t.getHandlerFunction() === 'pollTelegram') ScriptApp.deleteTrigger(t);
  });
  console.log('✅ Триггеры polling удалены.');
}

