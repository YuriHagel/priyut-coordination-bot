/**
 * Сбросить last_update_id в 0.
 * Бот начнёт обрабатывать все накопившиеся обновления Telegram.
 * Идемпотентность (isDuplicateUpdate_) защитит от повторов.
 */
function resetOffset() {
  const props = PropertiesService.getScriptProperties();
  const oldLast = props.getProperty(LAST_UPDATE_KEY) || '0';
  props.setProperty(LAST_UPDATE_KEY, '0');
  props.deleteProperty(FAILED_UPDATES_KEY);
  console.log('✅ last_update_id сброшен: ' + oldLast + ' → 0');
  console.log('Теперь бот получит все накопившиеся обновления.');
}

/**
 * Установить конкретное значение last_update_id.
 * Использовать, если знаете точный номер для старта.
 */
function setOffset(value) {
  const props = PropertiesService.getScriptProperties();
  const v = parseInt(value, 10);
  if (isNaN(v)) {
    console.error('❌ Некорректное значение:', value);
    return;
  }
  props.setProperty(LAST_UPDATE_KEY, String(v));
  console.log('✅ last_update_id установлен в:', v);
}

/**
 * Показать текущее значение last_update_id и счётчик неудачных апдейтов.
 */
function showOffset() {
  const props = PropertiesService.getScriptProperties();
  const lastUpdate = props.getProperty(LAST_UPDATE_KEY) || '0';
  const failed = readFailedUpdates_(props);
  console.log('📊 Текущие счётчики:');
  console.log('  last_update_id (идемпотентность/offset):', lastUpdate);
  console.log('  failed_updates:', JSON.stringify(failed));
}

/**
 * Полный сброс: счётчик идемпотентности + очистка неудачных + удаление webhook.
 * Использовать, если бот "застрял" и не реагирует на сообщения.
 */
function resetAllState() {
  const props = PropertiesService.getScriptProperties();
  props.setProperty(LAST_UPDATE_KEY, '0');
  props.deleteProperty(FAILED_UPDATES_KEY);
  console.log('✅ Счётчики сброшены.');

  // Удаляем webhook на всякий случай
  const result = callTelegramAPI_('deleteWebhook', { drop_pending_updates: true });
  console.log(result.ok ? '✅ Webhook удалён' : 'ℹ️ Webhook и так не установлен');

  console.log('🎯 Готово. Подождите 1 минуту — бот начнёт получать обновления.');
}

function testPollingManually() {
  console.log('🔍 Ручной тест polling...');

  const props = PropertiesService.getScriptProperties();
  const last = parseInt(props.getProperty(LAST_UPDATE_KEY) || '0', 10);
  const offset = last + 1;
  console.log('1. Текущий last_update_id:', last);

  const url = TELEGRAM_API + '/getUpdates?offset=' + offset + '&timeout=0';

  try {
    const resp = UrlFetchApp.fetch(url, { method: 'get', muteHttpExceptions: true });
    const data = JSON.parse(resp.getContentText());

    console.log('3. Ответ Telegram:', JSON.stringify(data, null, 2));

    if (!data.ok) {
      console.error('❌ Ошибка API:', data.description);
      return;
    }

    const updates = data.result || [];
    console.log('4. Количество обновлений:', updates.length);

    if (updates.length === 0) {
      console.log('ℹ️ Новых сообщений нет. Попробуйте написать боту и повторите testPollingManually.');
    } else {
      console.log('5. Первое обновление:', JSON.stringify(updates[0], null, 2));
    }

  } catch (error) {
    console.error('❌ Ошибка запроса:', error.toString());
  }
}
