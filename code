  console.log('🎯 Готово. Подождите 1 минуту — бот начнёт получать обновления.');
}

function testPollingManually() {
  console.log('🔍 Ручной тест polling...');
  
  const props = PropertiesService.getScriptProperties();
  const offset = props.getProperty(TG_OFFSET_KEY) || '0';
  console.log('1. Текущий TG_OFFSET:', offset);
  
  const url = TELEGRAM_API + '/getUpdates?offset=' + offset + '&timeout=0';
  console.log('2. Запрашиваем URL:', url);
  
  try {
    const resp = UrlFetchApp.fetch(url, { method: 'get', muteHttpExceptions: true });
    const data = JSON.parse(resp.getContentText());
    
    console.log('3. Ответ Telegram:', JSON.stringify(data, null, 2));
    
    if (!data.ok) {
      console.error('❌ Ошибка API:', data.description);
      return;
    }
    
    const updates = data.result || [];
    console.log('4. Количество обновлений:', updates.length);
    
    if (updates.length === 0) {
      console.log('ℹ️ Новых сообщений нет. Попробуйте написать боту и повторите testPollingManually.');
    } else {
      console.log('5. Первое обновление:', JSON.stringify(updates[0], null, 2));
    }
    
  } catch (error) {
    console.error('❌ Ошибка запроса:', error.toString());
  }
}
