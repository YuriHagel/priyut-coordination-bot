// ═══════════════════════════════════════════════════════════════

/**
 * Сбросить TG_OFFSET в 0.
 * Бот начнёт обрабатывать все накопившиеся обновления Telegram.
 * Идемпотентность (isDuplicateUpdate_) защитит от повторов.
 */
function resetOffset() {
  const props = PropertiesService.getScriptProperties();
  const oldOffset = props.getProperty(TG_OFFSET_KEY) || '0';
  props.setProperty(TG_OFFSET_KEY, '0');
  console.log('✅ TG_OFFSET сброшен: ' + oldOffset + ' → 0');
  console.log('Теперь бот получит все накопившиеся обновления.');
}

/**
 * Установить конкретное значение offset.
 * Использовать, если знаете точный offset для старта.
 */
function setOffset(value) {
  const props = PropertiesService.getScriptProperties();
  const v = parseInt(value, 10);
  if (isNaN(v)) {
    console.error('❌ Некорректное значение:', value);
    return;
  }
  props.setProperty(TG_OFFSET_KEY, String(v));
  console.log('✅ TG_OFFSET установлен в:', v);
}

/**
 * Показать текущее значение offset и last_update_id.
 */
function showOffset() {
  const props = PropertiesService.getScriptProperties();
  const tgOffset = props.getProperty(TG_OFFSET_KEY) || '0';
  const lastUpdate = props.getProperty('last_update_id') || '0';
  console.log('📊 Текущие счётчики:');
  console.log('  TG_OFFSET (polling):', tgOffset);
  console.log('  last_update_id (идемпотентность):', lastUpdate);
}

/**
 * Полный сброс: offset + счётчик идемпотентности + удаление webhook.
