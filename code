const SCRIPT_PROPS = PropertiesService.getScriptProperties();
const BOT_TOKEN = SCRIPT_PROPS.getProperty('BOT_TOKEN');

if (!BOT_TOKEN) {
  throw new Error('BOT_TOKEN не задан в Script Properties!');
}

const TELEGRAM_API = 'https://api.telegram.org/bot' + BOT_TOKEN;

// ID листов таблицы (загружаем один раз при старте скрипта)
const SHEET_NAMES = {
  VOLUNTEERS: 'Волонтёры',
  TRIPS: 'Поездки',
  RESPONSES: 'Отклики',
  LOG: 'Журнал',
  SETTINGS: 'Настройки',
