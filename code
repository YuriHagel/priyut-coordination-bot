  }

  text += 'Хотите стать автоволонтёром?';
  sendMessageWithButtons_(chatId, text, [[
    { text: '📝 Зарегистрироваться', callback_data: 'reg:start' },
    { text: '❓ Как это работает', callback_data: 'reg:how' }
  ]]);
}

