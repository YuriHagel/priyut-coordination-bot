/**
 * Главная точка входа — принимает POST-запросы от Telegram.
 * URL: https://script.google.com/macros/s/XXXXX/exec?secret=priyutino_2026_secret_xyz123
 */
function doPost(e) {
  try {

    const secret = e.parameter.secret;
    console.log('🔐 Проверка секрета:');
    console.log('  Получено из URL:', JSON.stringify(secret));
    console.log('  Ожидаемое (WEBHOOK_SECRET):', JSON.stringify(WEBHOOK_SECRET));
    console.log('  Совпадает:', secret === WEBHOOK_SECRET);
    // 1. Проверка секрета
    if (secret !== WEBHOOK_SECRET) {
      logEvent_('security', 'WEBHOOK_SECRET_MISMATCH', {
        received: secret,
        received_length: secret ? secret.length : 0,
        expected_length: WEBHOOK_SECRET ? WEBHOOK_SECRET.length : 0
      });
      return ContentService.createTextOutput('Unauthorized').setMimeType(ContentService.MimeType.TEXT);
    }

    // 2. Парсинг JSON
    const contents = JSON.parse(e.postData.contents);

    // 3. Идемпотентность — проверка update_id
    const updateId = contents.update_id;
    if (isDuplicateUpdate_(updateId)) {
      // ПРИМЕЧАНИЕ: НЕ логируем дубликаты — appendRow здесь поддерживал retry-петлю:
      // каждый retry застрявшего update_id вызывал медленную запись в Sheets, из-за чего
      // ответ не укладывался в таймаут Telegram (~10с) и Telegram пересылал снова.
      return ContentService.createTextOutput('OK').setMimeType(ContentService.MimeType.TEXT);
    }
    markUpdateProcessed_(updateId);

    // 4. Маршрутизация
    if (contents.message) {
      handleMessage_(contents.message);
    } else if (contents.callback_query) {
      handleCallback_(contents.callback_query);
    } else {
      logEvent_('webhook', 'UNKNOWN_UPDATE_TYPE', { contents: contents });
    }

    return ContentService.createTextOutput('OK').setMimeType(ContentService.MimeType.TEXT);

  } catch (error) {
    logEvent_('error', 'DO_POST_EXCEPTION', { error: error.toString(), stack: error.stack });
    return ContentService.createTextOutput('Error').setMimeType(ContentService.MimeType.TEXT);
  }
}

function handleMessage_(message) {
  const chatId = message.chat.id;
  const userId = message.from.id;
  const text = (message.text || '').trim();

  // ПРИМЕЧАНИЕ: намеренно НЕ логируем каждое сообщение (MESSAGE_RECEIVED) —
  // appendRow в hot path тормозил webhook-ответ за таймаут Telegram (~10с),
  // вызывая retry-петлю и потерю сообщений. Значимые события логируются ниже.

  // Wizard регистрации
  const regSession = getRegSession_(userId);
  if (regSession && text !== '' && text.charAt(0) !== '/') {
    processRegText_(userId, chatId, text, regSession);
    return;
  }

  // Wizard создания поездки
  const tripSession = getTripSession_(userId);
  if (tripSession && text !== '' && text.charAt(0) !== '/') {
    processTripText_(userId, chatId, text, tripSession);
    return;
  }

  // Причина отмены свободным текстом (волонтёр)
  if (getCnlSession_(userId) && text !== '' && text.charAt(0) !== '/') {
    processCancelReasonText_(userId, chatId, text);
    return;
  }  

  // Новое время поездки (админ)
  if (getChgSession_(userId) && text !== '' && text.charAt(0) !== '/') {
    processChangeTimeText_(userId, chatId, text);
    return;
  }

  if (text.charAt(0) === '/') {
    const command = text.split(' ')[0].split('@')[0];
    handleCommand_(command, message);
  } else {
    sendMessage_(chatId, 'Я понимаю только команды и кнопки.\nНапишите /help для списка команд.');
  }
}

function handleCallback_(callback) {
  const userId = callback.from.id;
  const data = callback.data || '';

  // ПРИМЕЧАНИЕ: аналогично handleMessage_ — НЕ логируем каждый callback
  // (CALLBACK_RECEIVED) во избежание appendRow в hot path.

  answerCallback_(callback.id);
  const id = function () { return parseInt(data.split(':')[1], 10); };

  // Ответы на кнопки в ПОСТАХ КАНАЛА приходят с chat.id канала,
  // поэтому отвечаем всегда в личный чат пользователя (userId).
  if (data.indexOf('reg:') === 0) {
    handleRegCallback_(userId, userId, data, callback.message.message_id);
  } else if (data.indexOf('adm:') === 0) {
    handleAdminCallback_(userId, userId, data);
  } else if (data.indexOf('tw:') === 0) {
    handleTripWizardCallback_(userId, userId, data);
  } else if (data.indexOf('resp:') === 0 || data.indexOf('skip:') === 0) {
    handleTripResponse_(userId, userId, data);
  } else if (data.indexOf('tappr:') === 0 || data.indexOf('trej:') === 0) {
    handleTripModeration_(userId, userId, data);
  } else if (data.indexOf('tcnlr:') === 0) {
    handleTripCancelReason_(userId, userId, data.split(':'));
  } else if (data.indexOf('tcnl:') === 0) {
    handleTripCancelStart_(userId, userId, id());
  } else if (data.indexOf('tdone:') === 0) {
    handleTripDone_(userId, userId, id());
  } else if (data.indexOf('tclose:') === 0) {
    handleTripClose_(userId, userId, id());
  } else if (data.indexOf('trework:') === 0) {
    handleTripRework_(userId, userId, id());
  } else if (data.indexOf('trep:') === 0) {
    handleTripRepublish_(userId, userId, id());
  } else if (data.indexOf('tcancel:') === 0) {
    handleTripFullCancel_(userId, userId, id());
  } else if (data.indexOf('tchg:') === 0) {
    handleTripChangeTimeStart_(userId, userId, id());
  } else if (data.indexOf('tconf:') === 0) {
    handleTripTimeConfirm_(userId, userId, id());
  } else if (data.indexOf('tref:') === 0) {
    handleTripTimeRefuse_(userId, userId, id());
  } else if (
    data.indexOf('r24y:') === 0 ||
    data.indexOf('r24n:') === 0 ||
    data.indexOf('r2y:') === 0 ||
    data.indexOf('r2n:') === 0
  ) {
    handleReminderAnswer_(userId, userId, data);
  } else if (data === 'pedit:0') {
    startRegEdit_(userId, userId);
  } else if (data === 'pdel:0') {
    cmdDeleteProfile_(userId, userId);
  } else if (data === 'pdely:0') {
    handleDeleteProfileConfirm_(userId, userId);
  } else if (data === 'pdeln:0') {
    sendMessage_(userId, '↩ Удаление отменено.');
  } else if (data === 'avon:0') {
    handleAvailabilityToggle_(userId, userId, true);
  } else if (data === 'avoff:0') {
    handleAvailabilityToggle_(userId, userId, false);
  } else if (data.indexOf('tnop:') === 0) {
    sendMessage_(userId, data === 'tnop:0' ? '↩ Действие отменено.' : 'ℹ️ Поездка на проверке у администратора.');
  } else {
    sendMessage_(userId, 'Неизвестная кнопка: ' + data);
  }
}

function handleCommand_(command, message) {
  const chatId = message.chat.id;
  const userId = message.from.id;
  const arg = (message.text || '').trim().split(' ').slice(1).join(' ').trim();

  switch (command) {
    case '/start': cmdStart_(chatId, userId); break;
    case '/help': cmdHelp_(chatId); break;
    case '/register': startRegistration_(userId, chatId); break;
    case '/new_trip': cmdNewTrip_(chatId, userId); break;
    case '/trips': cmdTrips_(chatId, userId); break;
    case '/open_trips': cmdOpenTrips_(chatId, userId); break;
    case '/my_trips': cmdMyTrips_(chatId, userId); break;
    case '/change_time': cmdChangeTime_(chatId, userId, arg); break;
    case '/cancel_trip': cmdCancelTrip_(chatId, userId, arg); break;
    case '/profile': cmdProfile_(chatId, userId); break;
    case '/availability': cmdAvailability_(chatId, userId); break;
    case '/stats': cmdStats_(chatId, userId); break;
    case '/volunteers': cmdVolunteers_(chatId, userId); break;
    case '/export_trips': cmdExportTrips_(chatId, userId); break;
    case '/delete_profile': cmdDeleteProfile_(chatId, userId); break;
    case '/withdraw_consent': cmdWithdrawConsent_(chatId, userId); break;
    case '/version': sendMessage_(chatId, '🛠 Сборка: ' + BUILD); break;
    default:
      sendMessage_(chatId, '❓ Неизвестная команда: ' + command + '\n\nНапишите /help для списка команд.');
  }
}

