/**
 * Тестовый GET-запрос для проверки доступности URL.
 * Откройте URL вашего веб-приложения в браузере, чтобы увидеть этот текст.
 */
function doGet(e) {
  const response = `✅ Бот Приютино работает!\n\n` +
                   `Время сервера: ${new Date().toISOString()}\n` +
                   `Секрет в URL: ${e.parameter.secret || 'не передан'}\n` +
                   `Токен бота загружен: ${!!BOT_TOKEN}`;

  return ContentService.createTextOutput(response).setMimeType(ContentService.MimeType.TEXT);
}
